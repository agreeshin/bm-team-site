---
import { Image, getImage } from 'astro:assets';
import ArrowIcon from '../components/ArrowIcon.astro';
import logo from '../../assets/UMT-logo.svg';
import logoPng from '../../assets/UMT-logo.png';
import brandMark from '../../assets/brand/brand-mark.svg';
import '@fontsource-variable/manrope';
import '../styles/global.css';

// The asset worker owns these originals. Glob also allows a useful, buildable
// text-first page while an image is being prepared, without broken image URLs.
const projectAssets = import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/*.webp', { eager: true });
const projectImage = (name: string) => projectAssets[`../../assets/projects/${name}.webp`]?.default;
const moltBoat = projectImage('molt-boat');
const warehouseDrone = projectImage('warehouse-drone');
const agrotechFarm = projectImage('agrotech-farm');
const literatureScreenshot = projectImage('kratchaishee');
const staticStars = Array.from({ length: 120 }, (_, i) => ({
  x: ((i * 137.508 + 31) % 1600), y: ((i * 237.13 + 17) % 800),
  radius: i % 7 === 0 ? 1.5 : .8, opacity: .25 + (i % 5) * .11,
}));

const title = 'Ursa Major Tech — ИИ и автоматизация бизнес-процессов';
const description = 'Автоматизируем рутину, обработку документов и работу с данными. ИИ-ассистенты, интеграции и инженерная разработка Ursa Major Tech — от пилота до внедрения.';
const canonical = Astro.site ? new URL('/', Astro.site).href : undefined;
const socialImage = Astro.site ? await getImage({ src: logoPng, format: 'png', width: 1024 }) : undefined;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Ursa Major Tech',
  legalName: 'ИП Гришин Анатолий Александрович',
  identifier: { '@type': 'PropertyValue', propertyID: 'ОГРНИП', value: '317665800027995' },
  email: 'greeshin.anatoly@yandex.ru',
  telephone: '+79320112811',
  description,
  ...(canonical ? { url: canonical, logo: new URL(logo.src, Astro.site).href } : {}),
};

const services = [
  { title: 'Автоматизируйте рутину. Масштабируйте прибыль', text: 'Автоматизируем разбор документов, извлечение данных и подготовку материалов.', icon: 'document' },
  { title: 'ИИ помощник ответит клиентам', text: 'ИИ-ассистенты находят ответы в базе знаний и помогают обрабатывать обращения.', icon: 'search' },
  { title: 'Объедините разрозненные системы', text: 'Связываем ваши сервисы и API, чтобы данные не приходилось переносить вручную.', icon: 'integration' },
  { title: 'Контролируйте процессы, а не экраны', text: 'Компьютерное зрение распознаёт события и передаёт важные сигналы в рабочие системы.', icon: 'vision' },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#071724" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={Astro.site ? 'index, follow' : 'noindex, nofollow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Ursa Major Tech" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={new URL(socialImage.src, Astro.site).href} />}
    {socialImage && <meta property="og:image:width" content="1024" />}
    {socialImage && <meta property="og:image:height" content="1024" />}
    {socialImage && <meta property="og:image:alt" content="Логотип команды Ursa Major Tech" />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={new URL(socialImage.src, Astro.site).href} />}
    <script type="application/ld+json" set:html={JSON.stringify(organization).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержимому</a>
    <header class="site-header" data-header>
      <div class="header-inner">
        <a class="brand" href="#top" aria-label="URSA MAJOR TECH — в начало страницы">
          <svg class="brand-lockup" viewBox="0 0 470 210" width="208" height="93" aria-hidden="true" focusable="false">
            <image href={brandMark.src} x="5" y="15" width="180" height="180" preserveAspectRatio="xMidYMid meet" />
            <text class="brand-lockup-main" x="214" y="61" fill="#edf1ee">URSA</text>
            <text class="brand-lockup-main" x="214" y="125" fill="#edf1ee">MAJOR</text>
            <text class="brand-lockup-accent" x="214" y="189" fill="#a3e4ec">TECH</text>
          </svg>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label="Открыть меню" hidden>
          <span></span><span></span>
        </button>
        <nav class="primary-nav" id="primary-nav" aria-label="Основная навигация">
          <a href="#expertise">Сделаем для Вас</a>
          <a href="#projects">Проекты</a>
          <a href="#approach">Подход</a>
          <a class="nav-contact" href="#contacts">Обсудить задачу <span aria-hidden="true"><ArrowIcon /></span></a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero-starfield" data-starfield aria-hidden="true">
          <svg class="starfield-fallback" viewBox="0 0 1600 800" preserveAspectRatio="none" fill="#b7dce5">{staticStars.map((star) => <circle cx={star.x} cy={star.y} r={star.radius} opacity={star.opacity} />)}</svg>
          <canvas class="starfield-canvas"></canvas>
          <div class="starfield-shade"></div>
        </div>
        <div class="container hero-inner">
          <div class="hero-copy">
            <h1 id="hero-title">ИИ, который<br />работает на<br /><span>ваш бизнес.</span></h1>
            <p class="hero-description">Автоматизируем рутину и связываем системы, чтобы ваша команда занималась главным.</p>
            <div class="hero-actions">
              <a class="button button-lime" href="#contacts">Обсудить задачу <span aria-hidden="true"><ArrowIcon /></span></a>
              <a class="text-link" href="#projects">Посмотреть проекты <span aria-hidden="true">↓</span></a>
            </div>
          </div>

        </div>
      </section>

      <section class="expertise section-space" id="expertise" aria-labelledby="expertise-title">
        <div class="container">
          <div class="section-heading" data-reveal><h2 id="expertise-title">Сделаем для Вас</h2></div>
          <div class="services-grid">
            {services.map((service, index) => <article class="service" data-reveal data-reveal-delay={(index % 2) * 80}>
              <div class="service-icon"><svg viewBox="0 0 40 40" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
                {service.icon === 'search' && <><circle cx="17" cy="17" r="10"/><path d="m24 24 10 10M12 17h10M17 12v10"/></>}
                {service.icon === 'document' && <><path d="M10 5h15l6 6v24H10zM24 5v8h7M15 20h11M15 26h8"/><path d="M5 11v24h19" opacity=".4"/></>}
                {service.icon === 'integration' && <><path d="M5 6h11v11H5zM24 23h11v11H24zM16 11h13v12M11 17v12h13"/><circle cx="29" cy="11" r="2"/><circle cx="11" cy="29" r="2"/></>}
                {service.icon === 'vision' && <><path d="M5 15V6h9M26 6h9v9M35 26v9h-9M14 35H5v-9"/><path d="M8 20s4-7 12-7 12 7 12 7-4 7-12 7S8 20 8 20Z"/><circle cx="20" cy="20" r="3"/></>}
              </svg></div>
              <h3>{service.title}</h3>
              <p>{service.text}</p>
            </article>)}
          </div>
        </div>
      </section>

      <section class="projects section-space" id="projects" aria-labelledby="projects-title">
        <div class="container">
          <div class="section-heading" data-reveal><h2 id="projects-title">Разработка в действии</h2></div>

          <article class="case case-literature">
            <div class="case-visual literature-visual" aria-label="Проект Кратчайшее.рф" data-reveal>
              {literatureScreenshot ? <div class="literature-browser"><div class="browser-bar" aria-hidden="true"><span></span><span></span><span></span></div><Image src={literatureScreenshot} width={1000} alt="Главная страница каталога Кратчайшее.рф" loading="lazy" sizes="(max-width: 700px) 100vw, 55vw" widths={[480, 760, 1000]} /></div> : <div class="image-pending">Кратчайшее.рф</div>}
            </div>
            <div class="case-copy" data-reveal data-reveal-delay="80"><h3>Кратчайшее.рф</h3><p>ИИ - краткие содержания литературных произведений с профессиональной озвучкой</p><a class="case-link" href="https://кратчайшее.рф" target="_blank" rel="noopener noreferrer">Открыть Кратчайшее.рф <span aria-hidden="true"><ArrowIcon /></span><span class="sr-only"> (в новой вкладке)</span></a></div>
          </article>

          <article class="case case-boat">
            <div class="case-visual case-photo boat-photo" data-reveal>
              {moltBoat ? <Image src={moltBoat} width={1100} alt="Гидрографический дрон Molt Boat на причале у воды" loading="lazy" sizes="(max-width: 760px) 100vw, 58vw" widths={[480, 760, 1100]} /> : <div class="image-pending"><span>MOLT BOAT</span><span>ГИДРОГРАФИЧЕСКИЙ ДРОН</span></div>}
            </div>
            <div class="case-copy" data-reveal data-reveal-delay="80"><h3>Molt Boat</h3><p>Разработали ПО управления гидрографическим дроном: маршруты, телеметрия и видео; участвовали в инженерной разработке.</p></div>
          </article>

          <article class="case case-warehouse">
            <div class="case-visual case-photo warehouse-photo" data-reveal>{warehouseDrone ? <Image src={warehouseDrone} width={493} alt="Прототип складского дрона в помещении склада" loading="lazy" sizes="(max-width: 700px) 70vw, 25vw" widths={[320, 493]} /> : <div class="image-pending">Складской дрон</div>}</div>
            <div class="case-copy" data-reveal data-reveal-delay="80"><h3>Складской дрон</h3><p>Прототип автономного дрона для складских проходов: полёт без GPS и компаса, нейросетевое распознавание штрихкодов.</p></div>
          </article>
          <article class="case case-farm">
            <div class="case-visual case-photo farm-photo" data-reveal>{agrotechFarm ? <Image src={agrotechFarm} width={800} alt="Вертикальная ферма АгроТехФарм со светодиодным освещением растений" loading="lazy" sizes="(max-width: 700px) 100vw, 55vw" widths={[480, 800]} /> : <div class="image-pending">АгроТехФарм</div>}</div>
            <div class="case-copy" data-reveal data-reveal-delay="80"><h3>АгроТехФарм</h3><p>Автоматизация вертикальной фермы: мониторинг среды, управление освещением и настроенные профили выращивания.</p></div>
          </article>
        </div>
      </section>

      <section class="approach section-space" id="approach" aria-labelledby="approach-title">
        <div class="container">
          <div class="section-heading" data-reveal><h2 id="approach-title">От задачи до внедрения</h2></div>
          <ol class="process-grid">
            <li data-reveal><h3>Разбираем задачу</h3><p>Определяем, что автоматизировать и как оценить результат.</p></li>
            <li data-reveal data-reveal-delay="60"><h3>Проверяем на пилоте</h3><p>Проверяем решение на ваших данных до масштабного внедрения.</p></li>
            <li data-reveal data-reveal-delay="120"><h3>Встраиваем и развиваем</h3><p>Подключаем системы, передаём решение команде и договариваемся о поддержке.</p></li>
          </ol>
        </div>
      </section>

      <section class="contacts section-space" id="contacts" aria-labelledby="contacts-title">
        <div class="container">
          <div class="contact-heading" data-reveal><h2 id="contacts-title">Что можно<br />делать <span>проще?</span></h2><div class="contact-intro"><p>Расскажите, какую задачу хотите автоматизировать.</p><a class="button button-lime" href="mailto:greeshin.anatoly@yandex.ru">Написать нам <span aria-hidden="true"><ArrowIcon /></span></a></div></div>
          <div class="contact-links" data-reveal><a class="email-link" href="mailto:greeshin.anatoly@yandex.ru"><span class="contact-label">Почта</span><span class="contact-value">greeshin.anatoly<wbr />@yandex.ru</span><span class="contact-arrow" aria-hidden="true"><ArrowIcon /></span></a><a class="phone-link" href="tel:+79320112811"><span class="contact-label">Телефон</span><span class="contact-value">+7 932 011-28-11</span><span class="contact-arrow" aria-hidden="true"><ArrowIcon /></span></a></div>
        </div>
      </section>
    </main>

    <footer class="site-footer"><div class="container footer-inner"><a class="footer-brand" href="#top">URSA MAJOR TECH</a><div class="legal"><span>ИП Гришин Анатолий Александрович</span><span>ОГРНИП 317665800027995</span></div><a class="back-top" href="#top">Наверх <span aria-hidden="true">↑</span></a></div></footer>

    <script>
      import { initNavigation } from '../scripts/navigation';
      import { initStarfield } from '../scripts/starfield';
      import { initScrollReveal } from '../scripts/scroll-reveal';
      initNavigation();
      initStarfield();
      initScrollReveal();
    </script>
  </body>
</html>
